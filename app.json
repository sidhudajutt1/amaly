{
  "expo": {
    "name": "Niyyah",
    "slug": "niyyah-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "niyyah",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6B4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.niyyah.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Niyyah needs your location to calculate accurate prayer times and Qibla direction.",
        "NSMotionUsageDescription": "Niyyah uses device sensors for the Qibla compass."
      }
    },
    "android": {
      "package": "com.niyyah.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6B4A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Niyyah needs your location to calculate accurate prayer times and Qibla direction."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
