{
  "name": "amaly-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "build:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "build:ios:production": "eas build --platform ios --profile production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/amiri-quran": "^0.4.1",
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "adhan": "^4.4.3",
    "expo": "~55.0.29",
    "expo-av": "^16.0.8",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.18",
    "expo-location": "~55.1.13",
    "expo-notifications": "~55.0.26",
    "expo-router": "~55.0.18",
    "expo-sensors": "~55.0.18",
    "expo-sharing": "~55.0.23",
    "expo-splash-screen": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.17",
    "hijri-converter": "^1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
